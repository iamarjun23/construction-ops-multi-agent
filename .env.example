# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_ops

# Chat LLM provider — "claude" or "ollama"
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Embeddings provider — Anthropic has no embeddings endpoint, so this is
# independent of LLM_PROVIDER. "openai" or "ollama".
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Ollama (used when LLM_PROVIDER=ollama and/or EMBEDDING_PROVIDER=ollama).
# OLLAMA_API_KEY is only needed for a hosted Ollama-compatible endpoint that
# requires a bearer token; leave blank for a local install.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large

# API server (src/api/server.ts)
PORT=3000
