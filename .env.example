# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/construction_ops

# Chat LLM provider — swappable; only "claude" is implemented in Phase 1
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Embeddings provider — Anthropic has no embeddings endpoint, so this is
# independent of LLM_PROVIDER. Only "openai" is implemented in Phase 1.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
