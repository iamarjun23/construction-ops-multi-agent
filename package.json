{
  "name": "construction-ops-multi-agent",
  "version": "0.1.0",
  "description": "Supervisor-based multi-agent RAG for construction payment/contract/progress questions",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "ingest:contracts": "tsx src/ingestion/ingest-contracts.ts",
    "rag:plain": "tsx src/rag/plain-rag.ts",
    "agents:single": "tsx src/rag/single-agent-baseline.ts",
    "agents:supervisor": "tsx src/supervisor/run.ts",
    "eval:audit-demo": "tsx eval/audit-demo.ts",
    "eval:generate-questions": "tsx eval/generate-questions.ts",
    "eval:run": "tsx eval/run-eval.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run ingest:contracts",
    "test": "vitest run",
    "api:dev": "tsx src/api/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "openai": "^4.77.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
